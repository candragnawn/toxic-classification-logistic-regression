    "import joblib\n",
    "from preprocessing.text_preprocessing import TextPreprocessorNonStopword\n",
    "\n",
    "preprocessor = TextPreprocessorNonStopword()\n",
    "\n",
    "vectorizer = joblib.load('exported_models/tfidf_vectorizer.pkl')\n",
    "classifier = joblib.load('exported_models/toxic_model.pkl')\n",
    "\n",
    "text = \"Wow, aren't you just the smartest person alive in the entire universe?\"\n",
    "\n",
    "cleaned_text = preprocessor.preprocess_text_non_stopword(text)\n",
    "\n",
    "text_vector = vectorizer.transform([cleaned_text])\n",
    "\n",
    "probs = classifier.model.predict_proba(text_vector)[0]\n",
    "\n",
    "prob_non_toxic = probs[0] * 100\n",
    "prob_toxic = probs[1] * 100\n",
    "\n",
    "print(f\"Teks Awal: '{text}'\")\n",
    "print(f\"Teks Clean: '{cleaned_text}'\")\n",
    "print(\"-\" * 30)\n",
    "print(f\"Persentase Toxic      : {round(prob_toxic, 2)}%\")\n",
    "print(f\"Persentase Non-Toxic  : {round(prob_non_toxic, 2)}%\")\n"
   ]
  }
